# SaatSaheli Frontend Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Backend API base URL
REACT_APP_API_URL=http://localhost:8081

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional welcome message in header
REACT_APP_WELCOME_MESSAGE=

# Google reCAPTCHA v2 ("I'm not a robot") site key — used on Contact + Feedback forms.
# Get yours at https://www.google.com/recaptcha/admin
REACT_APP_RECAPTCHA_SITE_KEY=
